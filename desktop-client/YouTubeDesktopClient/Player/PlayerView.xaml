<UserControl x:Class="YouTubeDesktopClient.Player.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The active tab's WebView2 is re-parented in here. On top of it, an
             overlay shown only when the embedded player can't play the video. -->
        <Grid Grid.Row="0">
            <ContentControl x:Name="WebHost"/>

            <Border x:Name="FallbackOverlay" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Canvas}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="420">
                    <TextBlock Text="This video can't be played in the embedded player"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <TextBlock Style="{StaticResource Text.Meta}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,8,0,16"
                               Text="Its owner has disabled embedding, or it isn't available. Open it on YouTube instead."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="OpenOnYouTubeButton" Content="Open on YouTube"
                                Style="{StaticResource Button.Primary}" Padding="14,6"
                                Click="OpenOnYouTube_Click"/>
                        <Button x:Name="OpenInBrowserButton" Content="Open in browser"
                                Margin="8,0,0,0" Padding="12,6" Click="OpenInBrowser_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Native metadata strip (embed mode only). -->
        <Border x:Name="MetaStrip" Grid.Row="1" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="16,10" MaxHeight="220">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Text.Meta}" Margin="0,4,0,0"/>
                <ScrollViewer x:Name="DescriptionScroller" MaxHeight="120" Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
