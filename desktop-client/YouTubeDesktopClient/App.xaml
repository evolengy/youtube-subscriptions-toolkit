<Application x:Class="YouTubeDesktopClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YouTubeDesktopClient">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme dictionary first: ThemeManager swaps this exact entry
                     (Light.xaml <-> Dark.xaml) in Application.Resources at runtime.
                     Controls.xaml carries only styles and references these tokens
                     via DynamicResource, so the swap re-paints the whole app. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
