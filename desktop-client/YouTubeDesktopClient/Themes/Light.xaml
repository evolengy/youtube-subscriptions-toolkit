<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light theme token values. Keys here are mirrored 1:1 in Dark.xaml — every
      Style in Controls.xaml references them via DynamicResource, so ThemeManager
      swapping this dictionary for Dark.xaml re-themes the whole app live.
      Accent.* is NOT defined here: it comes from the Windows system accent and
      is written into Application.Resources by ThemeManager.ApplyAccent().
    -->

    <!-- Surfaces: window canvas -> panels -> raised cards/popovers -->
    <Color x:Key="Color.Canvas">#FFF3F3F3</Color>
    <Color x:Key="Color.Surface">#FFECECEC</Color>
    <Color x:Key="Color.SurfaceHover">#FFE3E3E3</Color>
    <Color x:Key="Color.Elevated">#FFFFFFFF</Color>
    <Color x:Key="Color.ElevatedHover">#FFF5F5F5</Color>
    <Color x:Key="Color.BorderSubtle">#FFDFDFDF</Color>

    <Color x:Key="Color.TextPrimary">#FF1A1A1A</Color>
    <Color x:Key="Color.TextSecondary">#FF5F5F5F</Color>
    <Color x:Key="Color.TextTertiary">#FF8A8A8A</Color>

    <Color x:Key="Color.Danger">#FFC42B1C</Color>
    <Color x:Key="Color.Scrim">#55000000</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{DynamicResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Elevated" Color="{DynamicResource Color.Elevated}"/>
    <SolidColorBrush x:Key="Brush.ElevatedHover" Color="{DynamicResource Color.ElevatedHover}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{DynamicResource Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Color.Scrim}"/>

</ResourceDictionary>
