<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark theme. Keys mirror Light.xaml exactly. ThemeManager swaps this in for
      Light.xaml at runtime; Accent.* still comes from ThemeManager (system).
    -->

    <!--
      Near-flat, YouTube-style: Surface == Canvas, so the sidebar / toolbar /
      tab strip read as one dark plane, separated only by the 1px BorderSubtle
      hairline (which is therefore a touch more visible than in Light). Only
      genuine popovers — menus, combo dropdowns, settings cards, text inputs —
      get the faint Elevated lift.
    -->
    <Color x:Key="Color.Canvas">#FF0F0F0F</Color>
    <Color x:Key="Color.Surface">#FF0F0F0F</Color>
    <Color x:Key="Color.SurfaceHover">#FF272727</Color>
    <Color x:Key="Color.Elevated">#FF1E1E1E</Color>
    <Color x:Key="Color.ElevatedHover">#FF2A2A2A</Color>
    <!-- Nearly invisible: the sidebar / toolbar dividers should barely register
         (the prototype has none). Elevated surfaces read by their fill, not an
         outline. -->
    <Color x:Key="Color.BorderSubtle">#FF1C1C1C</Color>

    <Color x:Key="Color.TextPrimary">#FFF1F1F1</Color>
    <Color x:Key="Color.TextSecondary">#FFAAAAAA</Color>
    <Color x:Key="Color.TextTertiary">#FF7A7A7A</Color>

    <Color x:Key="Color.Danger">#FFFF99A4</Color>
    <Color x:Key="Color.Scrim">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{DynamicResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Elevated" Color="{DynamicResource Color.Elevated}"/>
    <SolidColorBrush x:Key="Brush.ElevatedHover" Color="{DynamicResource Color.ElevatedHover}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{DynamicResource Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Color.Scrim}"/>

</ResourceDictionary>
