<UserControl x:Class="YouTubeDesktopClient.Views.VideoCardGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <UserControl.Resources>
        <!-- Density-driven sizes; SetDensity() rewrites these and the card
             template (supplied by the consumer) picks it up via DynamicResource. -->
        <sys:Double x:Key="Feed.CardWidth">300</sys:Double>
        <sys:Double x:Key="Feed.ThumbHeight">169</sys:Double>
        <sys:Double x:Key="Feed.TitleHeight">38</sys:Double>
    </UserControl.Resources>

    <ListBox x:Name="Grid"
             ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
             ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.ScrollChanged="Grid_ScrollChanged">
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- Horizontal: fill a row then wrap DOWN -> vertical scroll,
                     columns reflow to width. MouseWheelDelta bumped from the
                     default (~48px) so one notch clears a card row. -->
                <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly"
                                           StretchItems="False" MouseWheelDelta="260"/>
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
            <!-- Cards aren't a selectable list; strip the hover/selection fill. -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
    </ListBox>
</UserControl>
