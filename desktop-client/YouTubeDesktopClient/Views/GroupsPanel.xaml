<UserControl x:Class="YouTubeDesktopClient.Views.GroupsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="Groups" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListBox x:Name="GroupList" MaxHeight="200" SelectionChanged="GroupList_SelectionChanged"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="NewGroupName" Width="140"/>
            <Button Content="Add" Click="AddGroup_Click" Margin="4,0,0,0"/>
        </StackPanel>
        <Button x:Name="RenameGroupButton" Content="Rename selected" Click="RenameGroup_Click"
                Margin="0,4,0,0" HorizontalAlignment="Left" IsEnabled="False"/>
        <TextBlock x:Name="ChannelsHeader" Text="Channels in group" FontWeight="Bold"
                   Margin="0,12,0,4" Visibility="Collapsed"/>
        <ListBox x:Name="ChannelList" MaxHeight="320" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
