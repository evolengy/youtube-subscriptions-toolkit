<UserControl x:Class="YouTubeDesktopClient.Views.PlaylistsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YouTubeDesktopClient.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="PlaylistItemCardTemplate">
            <Border x:Name="CardRoot" Background="{DynamicResource Brush.Elevated}" CornerRadius="14"
                    Width="{DynamicResource Feed.CardWidth}" Margin="6" Padding="6,6,6,10">
                <StackPanel>
                    <Border CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource Brush.Canvas}"
                            Height="{DynamicResource Feed.ThumbHeight}">
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Height="{DynamicResource Feed.TitleHeight}"
                               Margin="2,8,2,0" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Text.Meta}"
                               Margin="2,3,2,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="2,8,0,0" Opacity="0">
                        <Button Content="Play" Style="{StaticResource Button.Primary}"
                                Command="{Binding PlayCommand}" Padding="14,5"/>
                        <Button Content="Remove" Margin="8,0,0,0" Padding="10,5"
                                Command="{Binding RemoveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource Brush.ElevatedHover}"/>
                    <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: the playlist list + create box -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
            <DockPanel Margin="12,14">
                <TextBlock DockPanel.Dock="Top" Text="Playlists" Style="{StaticResource Text.SectionHeader}"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Content="New" Padding="12,6"
                            Margin="6,0,0,0" Click="AddPlaylist_Click"/>
                    <TextBox x:Name="NewNameBox" ToolTip="New playlist name"/>
                </DockPanel>
                <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="PlaylistList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Right: the selected playlist's videos -->
        <DockPanel Grid.Column="1" Margin="14,12">
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                <Button x:Name="PlayAllButton" DockPanel.Dock="Right" Content="Play all" Padding="12,6"
                        Click="PlayAll_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Text.Meta}"
                       Margin="2,4,0,0" Text="Select a playlist." />
            <local:VideoCardGrid x:Name="Cards" ItemTemplate="{StaticResource PlaylistItemCardTemplate}"/>
        </DockPanel>
    </Grid>
</UserControl>
