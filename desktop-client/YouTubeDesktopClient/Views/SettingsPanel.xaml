<UserControl x:Class="YouTubeDesktopClient.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Canvas}">
        <StackPanel Margin="24" MaxWidth="520" HorizontalAlignment="Left">

            <TextBlock Text="Appearance" Style="{StaticResource Text.SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Theme" Margin="0,0,0,6"/>
                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light"/>
                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark"/>
                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Follow system"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Startup" Style="{StaticResource Text.SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                <CheckBox x:Name="StartWithWindowsBox"
                          Content="Start YouTube Desktop Client when I sign in to Windows"/>
            </Border>

            <TextBlock Text="Playback" Style="{StaticResource Text.SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
                <StackPanel>
                    <RadioButton x:Name="PlaybackEmbed" GroupName="Playback"
                                 Content="Embedded player (no sign-in needed)"/>
                    <RadioButton x:Name="PlaybackFullPage" GroupName="Playback" Margin="0,4,0,0"
                                 Content="Full YouTube page (writes watch history when signed in)"/>
                    <TextBlock Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The embedded player uses YouTube's official IFrame API — it never needs a YouTube web login and is not affected by the API quota, but playback is not added to your watch history. Applies to videos opened after the change."/>
                </StackPanel>
            </Border>

            <TextBlock Text="Feed" Style="{StaticResource Text.SectionHeader}"/>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Density" Margin="0,0,0,6"/>
                    <RadioButton x:Name="DensityComfortable" GroupName="Density" Content="Comfortable"/>
                    <RadioButton x:Name="DensityCompact" GroupName="Density" Content="Compact"/>

                    <CheckBox x:Name="AutoExpandBox" Margin="0,14,0,0"
                              Content="Automatically load older videos from YouTube while scrolling"/>
                    <TextBlock Style="{StaticResource Text.Meta}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="When the cached feed runs out, the app fetches more history. Turn off to stay on the local cache only."/>

                    <TextBlock x:Name="LastSyncedText" Style="{StaticResource Text.Meta}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
