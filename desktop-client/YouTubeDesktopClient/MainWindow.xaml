<Window x:Class="YouTubeDesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Desktop Client" Height="800" Width="1280"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Canvas}"
        StateChanged="MainWindow_StateChanged" Closing="MainWindow_Closing">
    <Grid Background="{DynamicResource Brush.Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: brand, destination nav, then the groups panel fills the rest.
             No divider — the prototype's shell is seamless; regions read by content. -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="&#xE768;" FontFamily="{DynamicResource Font.Icon}" FontSize="13"
                                       Foreground="{DynamicResource Brush.AccentFg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YouTube Desktop" FontWeight="SemiBold" FontSize="14"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="bar" Width="3" HorizontalAlignment="Left"
                                                        CornerRadius="2" Background="Transparent"/>
                                                <Border x:Name="bd" Margin="0" CornerRadius="6"
                                                        Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSubtle}"/>
                                                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="feed" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Width="26"/>
                                <TextBlock Text="Feed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="home" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Width="26"/>
                                <TextBlock Text="Home" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="playlists" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Width="26"/>
                                <TextBlock Text="Playlists" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="channels" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Width="26"/>
                                <TextBlock Text="Channels" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings" Padding="8,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource Font.Icon}" FontSize="16" Width="26"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <ContentControl x:Name="GroupsHost"/>
            </DockPanel>
        </Border>

        <!-- Main area: top strip of open video tabs + toolbar icons, then content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}">
                <DockPanel Margin="8,6">
                    <Button x:Name="AccountButton" DockPanel.Dock="Right" Background="Transparent"
                            BorderThickness="0" Padding="8,4" Margin="4,0,0,0" MinHeight="30"
                            Click="AccountButton_Click"/>
                    <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="-180" VerticalOffset="6">
                        <Border Background="{DynamicResource Brush.Elevated}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                                CornerRadius="8" Width="240" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="AccountPopupName" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AccountPopupHandle" Style="{StaticResource Text.Meta}"
                                           Margin="0,2,0,12" TextTrimming="CharacterEllipsis"/>
                                <Button Content="Sign out" HorizontalAlignment="Left" Padding="12,5"
                                        Click="SignOut_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                            Content="&#xE72C;" ToolTip="Refresh now" Margin="4,0,0,0" Click="RefreshButton_Click"/>
                    <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                            Content="&#xE706;" ToolTip="Theme" Margin="4,0,0,0" Click="ThemeToggleButton_Click"/>
                    <Button x:Name="LogButton" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}"
                            Content="&#xE7BA;" ToolTip="Notifications" Click="LogButton_Click"/>
                    <Popup x:Name="LogPopup" PlacementTarget="{Binding ElementName=LogButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-300" VerticalOffset="6">
                        <Border Background="{DynamicResource Brush.Elevated}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1" CornerRadius="8" Width="340" Padding="4">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="8,6,4,8">
                                    <TextBlock Text="Notifications" FontWeight="SemiBold" DockPanel.Dock="Left"
                                               VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Clear" Padding="8,3" Click="ClearLog_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Log file" Padding="8,3" Margin="0,0,6,0"
                                            Click="OpenLogFile_Click"/>
                                </DockPanel>
                                <TextBlock x:Name="LogEmptyText" Text="Nothing to report." Style="{StaticResource Text.Meta}"
                                           Margin="10,6,10,10" Visibility="Collapsed"/>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="2" CornerRadius="4"
                                                        Background="{DynamicResource Brush.SurfaceHover}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Text.Meta}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="VideoTabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
